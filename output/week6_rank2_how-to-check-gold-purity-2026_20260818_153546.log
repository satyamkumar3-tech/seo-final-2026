/bin/zsh -lc "python3 -c \"import json,urllib.request; ids=[34800,34801,34802,34803,34804,34805,34812,34813,34814]; out=[]; [(lambda d: out.append({'id':d['id'],'slug':d['slug'],'alt_text':d['alt_text'],'title':d['title']['rendered'],'source_url':d['source_url']}))(json.load(urllib.request.urlopen(f'https://blog.bluestone.com/wp-json/wp/v2/media/{i}',timeout=60))) for i in ids]; print(json.dumps(out,indent=2))\"" in /Users/vikasindoria/Documents/Geo and Seo/final seo generation context
