+      "url": "https://www.bluestone.com/earrings/the-ursa-hoop-earrings~35069.html",
+      "png": "ProductImages/seo images/Earrings/The Ursa Hoop Earrings.png"
+    },
+    {
+      "code": "BISM0003O14",
+      "name": "The Muricelle Bangle",
+      "url": "https://www.bluestone.com/bangles/the-muricelle-bangle~1001.html",
+      "png": "ProductImages/seo images/Bangles/The Muricelle Bangle.png"
+    },
+    {
+      "code": "BIPO0730V39",
+      "name": "The Kricia Charm Bracelet",
+      "url": "https://www.bluestone.com/bracelets/the-kricia-charm-bracelet~75605.html",
+      "png": "ProductImages/seo images/Bracelet/The Kricia Charm Bracelet.png"
