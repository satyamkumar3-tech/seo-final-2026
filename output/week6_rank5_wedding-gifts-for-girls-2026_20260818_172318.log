+import json
+import re
+from urllib.parse import urlparse
+
+from bs4 import BeautifulSoup
+
+
+html = open("/tmp/week6_rank5_live.html", encoding="utf-8").read()
+soup = BeautifulSoup(html, "html.parser")
+entry = soup.select_one("div.entry-content")
+if entry is None:
+    raise SystemExit("entry content not found")
+
+for node in entry.select("style,script"):
+    node.decompose()
+
+visible_text = " ".join(entry.stripped_strings)
+visible_words = re.findall(r"[A-Za-z0-9]+(?:['’][A-Za-z0-9]+)*", visible_text)
+headings_1 = soup.find_all("h1")
+headings_2 = entry.find_all("h2")
+carousel_cards = entry.select("#bs-cf-weddinggiftsgirls .bs-cf-card")
+buy_links = entry.find_all("a", string=lambda value: value and value.strip() == "Buy now")
+
+links = [anchor.get("href", "") for anchor in entry.find_all("a")]
+internal_links = [
+    url
+    for url in links
+    if urlparse(url).netloc == "blog.bluestone.com"
+    and "wedding-gifts-for-girls-2026" not in url
+]
+external_links = [
+    url
+    for url in links
+    if urlparse(url).netloc and urlparse(url).netloc != "blog.bluestone.com"
+]
+
+post = json.load(open("/tmp/week6_rank5_post.json", encoding="utf-8"))
+rendered = BeautifulSoup(post["content"]["rendered"], "html.parser")
+faq_schema = json.loads(rendered.find("script", id="bs-faq-schema").string)
+blog_schema = json.loads(rendered.find("script", id="bs-blogposting-schema").string)
+hero_media = json.load(open("/tmp/week6_rank5_media_hero.json", encoding="utf-8"))
+body_media = json.load(open("/tmp/week6_rank5_media_body.json", encoding="utf-8"))
+
+images = entry.find_all("img")
+result = {
+    "visible_words": len(visible_words),
+    "h1_count": len(headings_1),
+    "h1_text": [heading.get_text(" ", strip=True) for heading in headings_1],
+    "h2_count": len(headings_2),
+    "h2_text": [heading.get_text(" ", strip=True) for heading in headings_2],
+    "carousel_cards": len(carousel_cards),
+    "buy_links": len(buy_links),
+    "faq_schema_count": len(faq_schema["mainEntity"]),
+    "blog_schema_images": len(blog_schema["image"]),
+    "internal_links": len(set(internal_links)),
+    "external_links": len(set(external_links)),
+    "body_images": len(images),
+    "webp_body_images": sum(".webp" in image.get("src", "") for image in images),
+    "alts_unique": len({image.get("alt", "") for image in images}) == len(images),
+    "empty_alts": sum(not image.get("alt") for image in images),
+    "hero_in_body": hero_media["source_url"] in str(entry),
+    "featured_media": post["featured_media"],
+    "author": post["author"],
+    "categories": post["categories"],
+    "status": post["status"],
+    "slug": post["slug"],
+    "em_dash": visible_text.count(chr(8212)),
+    "en_dash": visible_text.count(chr(8211)),
+    "spaced_hyphen": len(re.findall(r"\s-\s", visible_text)),
+    "price_patterns": len(re.findall(r"₹|\bRs\.?\s*\d|\bINR\s*\d", visible_text, re.I)),
+    "body_captions": [caption.get_text(" ", strip=True) for caption in entry.select("figcaption")],
+    "hero_media": hero_media,
+    "body_media": body_media,
+}
+
+print(json.dumps(result, indent=2, ensure_ascii=False))
