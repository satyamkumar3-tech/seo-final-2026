+        super().__init__()
+        self.skip_depth = 0
+        self.text = []
+        self.h2_text = []
+        self.caption_text = []
+        self.current_h2 = None
+        self.current_caption = None
+        self.links = []
+        self.images = []
+        self.carousel_cards = 0
