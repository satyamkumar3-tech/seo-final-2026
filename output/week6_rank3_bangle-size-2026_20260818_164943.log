+entries = doc.xpath(
+    '//*[contains(concat(" ", normalize-space(@class), " "), " wp-block-post-content ")]'
+)
+if not entries:
+    entries = doc.xpath(
+        '//*[contains(concat(" ", normalize-space(@class), " "), " entry-content ")]'
+    )
+if not entries:
+    raise SystemExit("Could not locate post content container")
+entry = entries[0]
+clean = copy.deepcopy(entry)
